# Server-side bindings only. Never commit real secrets.
SESSION_SECRET=
BOOTSTRAP_TOKEN=

# One workspace-level encryption key for employees' BYOK credentials.
# Store as a Cloudflare Secret. Do not rotate casually; existing encrypted keys depend on it.
AI_CREDENTIALS_MASTER_KEY=

# Universal AI Gateway routing. These are workspace fallbacks only.
AI_DEFAULT_PROVIDER=
AI_RESEARCH_PROVIDER=
AI_DRAFT_PROVIDER=
AI_RESEARCH_DAILY_LIMIT=30
AI_DRAFT_DAILY_LIMIT=100

# Optional workspace fallback providers. Employees can instead save their own keys in Settings → AI Providers.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESEARCH_MODEL=
OPENAI_DRAFT_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_RESEARCH_MODEL=
ANTHROPIC_DRAFT_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RESEARCH_MODEL=
GEMINI_DRAFT_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
XAI_API_KEY=
XAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional workspace custom providers. Personal custom providers are configured from the web UI.
AI_PROVIDER_CONFIG_JSON=[]

APOLLO_API_KEY=
HUNTER_API_KEY=
