# Example:
# CUSTOM_QWEN_KEY=
# AI_PROVIDER_CONFIG_JSON=[{"id":"qwen","name":"Qwen","protocol":"openai_chat","baseUrl":"https://example-provider/v1","model":"your-model-id","secretEnv":"CUSTOM_QWEN_KEY","capabilities":{"webSearch":false}}]
AI_PROVIDER_CONFIG_JSON=[]

